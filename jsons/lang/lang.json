        "Name": {
          "en": "Wild West"
        },
        "EndlessZoneName": {
          "en": "Big Bad Butte"
        },
        "Description": {
          "en": "Head down the dusty trail for a showdown with the outlaw zombies of yesteryear! Gather up your plants for the big Brain Rush of 1850!"
        }
      },
      "Kongfu": {
        "Name": {
          "en": "Kongfu Temple"
        },
        "EndlessZoneName": {
          "en": "Martial Arts Competitions"
        },
        "Description": {
          "en": "Back to the year 1673, when kongfu culture is prevalent all over China. Are you prepared for the battle between the skilled plants and the experienced zombies?"
        }
      },
      "Future": {
        "Name": {
          "en": "Far Future"
        },
        "EndlessZoneName": {
          "en": "Terror from Tomorrow"
        },
        "Description": {
          "en": "In the year 2323, the zombies will have brain extraction down to a science! Can the plants of the future save you from the undead of tomorrow?"
        }
      },
      "Dark": {
        "Name": {
          "en": "Dark Ages"
        },
        "EndlessZoneName": {
          "en": "Arthur's Challenge"
        },
        "Description": {
          "en": "Bring out your undead to the year 948! Harvest mushrooms in the dark of knight and get medieval on zombies from the days of yore!"
        }
      },
      "Beach": {
        "Name": {
          "en": "Big Wave Beach"
        },
        "EndlessZoneName": {
          "en": "Tiki Torch-er"
        },
        "EndlessZoneMiniGameName": {
          "en": "Wall-nut Bowling"
        },
        "Description": {
          "en": "Take a trip back to the '60s and hang the ten on the ocean waves! Tides are changing and those gnarly zombies make it not-so-safe to go back in the water!"
        }
      },
      "Iceage": {
        "Name": {
          "en": "Frostbite Caves"
        },
        "EndlessZoneName": {
          "en": "Icebound Battleground"
        },
        "Description": {
          "en": "Explore the frozen wastes of prehistory and chill out with the coolest zombies ever. Beware the winds or your plants will be frozen veggies."
        }
      },
      "Lostcity": {
        "Name": {
          "en": "Lost City"
        },
        "EndlessZoneName": {
          "en": "Temple of Bloom"
        },
        "Description": {
          "en": "Discover the vanished city of gold, where sun is plentiful and misplaced zombies abound! Use special tiles for extra sun, for these treasure-seekers are no idol threat!"
        }
      },
