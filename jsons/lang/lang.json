        "Name": {
          "en": "Pirate Seas"
        },
        "EndlessZoneName": {
          "en": "Dead Man's Booty"
        },
        "Description": {
          "en": "The year is 1679, the golden age of zombie piracy! Keep your booty close, and your plants closer, as the zombies take to the sea to plunder your brains!"
        }
      },
