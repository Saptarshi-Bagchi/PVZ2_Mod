          "en": "Aerial Fortress"
        },
        "EndlessZoneName": {
          "en": "Thunder Firmament"
        },
        "Description": {
          "en": "This is the vast, endless sky, with clouds full of dangerous lightning. Zombies pilot all kinds of hazardous weapons — you will face challenges like never before."
        }
